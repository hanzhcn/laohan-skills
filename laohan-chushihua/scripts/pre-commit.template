#!/bin/bash
# pre-commit 模板(治理仓分发;源=laohanAI .githooks/pre-commit,2026-09-30 v1)
# 新项目接入: cp 本文件到 <项目>/.githooks/pre-commit && chmod +x 后 git config core.hooksPath .githooks
# 按项目调整: ②段 1500 行红线与 scripts/check_source_size.py 引用在无该脚本的项目可删或换项目自己的规模守卫;
#             ③段「任务生命周期三段制/worktree」语义以项目 AGENTS.md 定义为准(纯文档/单文件例外的白名单同理)。
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1

audit() { echo "$(date '+%F %T') 豁免 $1 @ $(git rev-parse --short HEAD 2>/dev/null || echo new) staged: $(git diff --cached --name-only | tr '\n' ' ' | cut -c1-120)" >> .git/LAOHAN_allow.log; }
die() {
  echo "❌ pre-commit: $1" >&2
  echo "   当前段豁免(人工确认后使用,可审计):$2" >&2
  exit 1
}

# ① secret 快扫(只看暂存新增行;模式取高置信家族,宁可误报走人工复核也不放真 key)
if [ "${LAOHAN_ALLOW_SECRET_SCAN:-}" = "1" ]; then audit 1-secret;
else
leak="$(git diff --cached -U0 --no-color 2>/dev/null \
  | grep -nEi '(-----BEGIN (RSA|EC|OPENSSH|DSA) PRIVATE KEY-----|sk-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{30,}|gho_[A-Za-z0-9]{30,}|xox[baprs]-[A-Za-z0-9-]{10,}|(api|secret|access)[_-]?key["'"'"' ]*[:=]["'"'"' ]?[A-Za-z0-9._-]{32,})' \
  | head -3 || true)"
if [ -n "$leak" ]; then
  echo "$leak" | cut -c1-160 | sed 's/^/   /' >&2
  die "暂存内容疑似密钥/私钥(上方为命中行,已截断)。全量口径:python3 -I scripts/security/scan_tracked_secrets.py;确认误报后再提交" \
      "LAOHAN_ALLOW_SECRET_SCAN=1 git commit ...(仅豁免本段)"
fi
fi

# ② 1500 行红线快查(只对**新增**文件生效;既有文件的规模治理归 check_source_size.py 基线机制——
#    基线内大文件(如 Workspace.tsx)的正常修改不在此拦,否则会把日常提交拦死;2026-09-30 自审实锤修正)
if [ "${LAOHAN_ALLOW_SIZE_CHECK:-}" = "1" ]; then audit 2-size;
else
while IFS= read -r f; do
  case "$f" in
    *.ts|*.tsx|*.mjs|*.js|*.py|*.rs)
      n="$(git show ":$f" 2>/dev/null | wc -l | tr -d ' ')"
      if [ -n "$n" ] && [ "$n" -gt 1500 ]; then
        die "$f 暂存版 $n 行,超生产源码 1500 行红线(新功能一律进新文件,超标文件只减不增)。" \
            "LAOHAN_ALLOW_SIZE_CHECK=1 git commit ...(仅豁免本段)"
      fi
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=A)
fi

# ③ 主检出 + main 直提交守卫
if [ "${LAOHAN_ALLOW_MAIN_COMMIT:-}" = "1" ]; then audit 3-main; exit 0; fi
gd="$(git rev-parse --git-dir)"; gcd="$(git rev-parse --git-common-dir)"
[ "$gd" = "$gcd" ] || exit 0                       # worktree 车道内(三段制的「干」)不受限
git rev-parse --verify -q HEAD >/dev/null 2>&1 || exit 0   # 空仓库首次初始化提交放行(多文件骨架必然;init-project 判例 2026-09-30)
branch="$(git symbolic-ref -q --short HEAD || true)"
[ "$branch" = "main" ] || exit 0
for sq in MERGE_HEAD SQUASH_MSG CHERRY_PICK_HEAD REVERT_HEAD; do
  [ -e "$(git rev-parse --git-path "$sq")" ] && exit 0   # 集成/回滚类提交放行
done
files="$(git diff --cached --name-only --diff-filter=ACMR | grep -v '^\.githooks/' || true)"
n_nondoc="$(printf '%s\n' $files | grep -vcE '^($|docs/|.*\.md$|STATUS\.md$)' || true)"
total="$(printf '%s\n' $files | grep -c . || true)"
if [ "$n_nondoc" -gt 0 ] && [ "$total" -gt 1 ]; then
  die "主检出的 main 直提交含 $total 个文件(含非文档)。多文件改动走任务生命周期三段制(独立 worktree+分支);纯文档与单文件定点修复不受限。" \
      "LAOHAN_ALLOW_MAIN_COMMIT=1 git commit ...(仅豁免本段)"
fi
exit 0
